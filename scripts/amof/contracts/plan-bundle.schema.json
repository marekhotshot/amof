{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amof.dev/contracts/plan-bundle.schema.json",
  "title": "PlanBundle",
  "description": "Canonical proposal-only planning contract shared by conversational intake and planning surfaces before approval and execution.",
  "type": "object",
  "required": [
    "result_kind",
    "contract_version",
    "objective",
    "repo_scope",
    "files_to_inspect",
    "proposed_steps",
    "risks",
    "validation_plan",
    "execution_prompt_for_director",
    "requires_user_approval",
    "execution_allowed"
  ],
  "properties": {
    "result_kind": {
      "type": "string",
      "const": "plan_bundle"
    },
    "contract_version": {
      "type": "string",
      "const": "plan-bundle-v1"
    },
    "ticket_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "proposed_ticket_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "repo_scope": {
      "type": "string",
      "minLength": 1
    },
    "files_to_inspect": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_prompt_for_director": {
      "type": "string",
      "minLength": 1
    },
    "requires_user_approval": {
      "type": "boolean",
      "const": true
    },
    "execution_allowed": {
      "type": "boolean",
      "const": false
    },
    "interpretations": {
      "type": "array",
      "description": "Optional cognition field: role-bound interpretations of the planning context. Absent when unknown.",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["interpreter", "planner", "critic"]
          }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "description": "Optional planner confidence in [0, 1]. Absent when unknown; never fabricate 0.0.",
      "minimum": 0,
      "maximum": 1
    },
    "dissent": {
      "type": "array",
      "description": "Optional cognition field: risk-gated Critic dissent entries. Absent when critique did not run.",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "suggested_next_actions": {
      "type": "array",
      "description": "Optional typed proposal cards (label + intake prefill). Never executable commands.",
      "items": {
        "type": "object",
        "required": ["label", "prefill"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "prefill": {
            "type": "object",
            "required": ["intake_text"],
            "properties": {
              "intake_text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "anyOf": [
    {
      "required": ["ticket_id"]
    },
    {
      "required": ["proposed_ticket_id"]
    }
  ],
  "additionalProperties": false
}
