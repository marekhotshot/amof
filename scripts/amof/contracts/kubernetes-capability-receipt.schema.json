{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amof.dev/contracts/kubernetes-capability-receipt.schema.json",
  "title": "Kubernetes Capability Receipt",
  "description": "Runtime proof of one Kubernetes capability attempt. Secrets and raw payloads are omitted; changes are hashed. UNVERIFIED must never become PASS.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "receipt_id",
    "run_id",
    "mission_id",
    "requested_by",
    "approval_id",
    "binding_id",
    "capability",
    "granted",
    "target",
    "operation",
    "within_scope",
    "verification",
    "executed",
    "compliance",
    "acceptance_state",
    "created_at",
    "evaluated_at",
    "secrets_omitted"
  ],
  "properties": {
    "kind": { "type": "string", "const": "kubernetes_capability_receipt" },
    "schema_version": { "type": "integer", "const": 1 },
    "receipt_id": { "type": "string", "pattern": "^kcr-[0-9a-f]{24}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string" },
    "proposal_id": { "type": "string", "pattern": "^kcp-[0-9a-f]{24}$" },
    "approval_id": { "type": "string", "pattern": "^kca-[0-9a-f]{24}$" },
    "binding_id": { "type": "string", "pattern": "^kcb-[0-9a-f]{24}$" },
    "capability": {
      "type": "string",
      "enum": ["kubernetes.read", "kubernetes.mutate"]
    },
    "granted": { "type": "object", "additionalProperties": true },
    "target": {
      "type": "object",
      "required": ["cluster", "namespace", "resource"],
      "properties": {
        "cluster": { "type": "string" },
        "namespace": { "type": "string" },
        "resource": { "type": "string" },
        "name": { "type": ["string", "null"] }
      }
    },
    "operation": {
      "type": "object",
      "required": ["verb", "digest"],
      "properties": {
        "verb": { "type": "string" },
        "name": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "change": {
      "type": ["object", "null"],
      "properties": {
        "digest": { "type": ["string", "null"] },
        "before_digest": { "type": ["string", "null"] },
        "after_digest": { "type": ["string", "null"] },
        "before_generation": { "type": ["integer", "null"] },
        "after_generation": { "type": ["integer", "null"] },
        "before_resource_version": { "type": ["string", "null"] },
        "after_resource_version": { "type": ["string", "null"] },
        "changed": { "type": "boolean" }
      }
    },
    "within_scope": { "type": "boolean" },
    "verification": {
      "type": "object",
      "required": ["verified"],
      "properties": {
        "method": { "type": ["string", "null"] },
        "verified": { "type": "boolean" }
      }
    },
    "executed": { "type": "boolean" },
    "compliance": {
      "type": "string",
      "enum": ["within_scope", "denied", "unverified"]
    },
    "acceptance_state": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNVERIFIED"]
    },
    "binding_status": { "type": "string" },
    "approval_status": { "type": "string" },
    "created_at": { "type": "string" },
    "evaluated_at": { "type": "string" },
    "stop_reason": { "type": ["string", "null"] },
    "denial_code": { "type": ["string", "null"] },
    "secrets_omitted": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
