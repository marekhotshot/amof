{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amof.dev/contracts/write-scope-proposal.schema.json",
  "title": "Write Scope Proposal",
  "description": "Durable, addressable write-scope proposal evidence object. Proposals are untrusted evidence emitted by workers; they never authorize mutation.",
  "type": "object",
  "$defs": {
    "WriteScopeBody": {
      "type": "object",
      "description": "Frozen normalized write-scope body. reason is human rationale and is non-authoritative for body_hash identity.",
      "required": [
        "target_id",
        "base_sha",
        "allowed_roots",
        "denied_roots",
        "reason",
        "expected_checks",
        "docs_only",
        "source_mutation"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "allowed_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "denied_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expected_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "docs_only": {
          "type": "boolean"
        },
        "source_mutation": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schema_version",
    "proposal_id",
    "run_id",
    "body",
    "body_hash",
    "created_at",
    "status"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "write_scope_proposal"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^wsp-[0-9a-f]{24}$",
      "description": "Deterministic id: wsp- + sha256(run_id + ':' + body_hash)[:24]."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Parent AgentRunResult session_id / run_id. Required; proposals without a parent run are rejected."
    },
    "body": {
      "$ref": "#/$defs/WriteScopeBody"
    },
    "body_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Deterministic hash over canonical body fields excluding reason (non-authoritative). Includes target_id, base_sha, allowed_roots, denied_roots, expected_checks, docs_only, source_mutation."
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 creation timestamp. Idempotent re-ingest preserves the original created_at."
    },
    "status": {
      "type": "string",
      "enum": ["proposed"],
      "description": "Wave 1 lifecycle status. proposed only — no approval/binding authority."
    }
  },
  "additionalProperties": false
}
