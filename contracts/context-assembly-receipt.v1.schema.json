{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amof.context-assembly.receipt.v1",
  "title": "AMOF context-assembly receipt",
  "description": "First-turn Native assembly receipt. Records hashes and sizes of what AMOF assembled before JIT. Does not persist prompt bodies or invent a context planner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "call_index",
    "model",
    "sections",
    "tools",
    "assembled",
    "omissions"
  ],
  "properties": {
    "schema": {
      "const": "amof.context-assembly.receipt.v1"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "call_index": { "type": "integer", "minimum": 1 },
    "model": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "authority_class",
          "source",
          "sha256",
          "bytes",
          "tokens"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "system",
              "runtime-envelope",
              "mission",
              "phase-override"
            ]
          },
          "authority_class": {
            "type": "string",
            "enum": ["runtime-contract", "sealed-mission"]
          },
          "source": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "tokens": {
            "description": "Provider-attributed section tokens. Null when not measured. Do not estimate.",
            "type": ["integer", "null"],
            "minimum": 0
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "schema_hash"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "schema_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "assembled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "prompt_tokens"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "prompt_tokens": {
          "description": "Provider prompt_tokens for this call. Null on scripted / no-model paths.",
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "reason"],
        "properties": {
          "class": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
